VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://people-records.example.com/api
# Non-secret Worker configuration. Must match the SPA settings above.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://people-records.example.com/api
# Production residency. Account and zone IDs are non-secret; use your own values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_APP_HOSTNAME=
# strict (default) requires Enterprise regionalization; best-effort retains EU storage
# but cannot guarantee request execution/TLS/metadata residency.
CLOUDFLARE_RESIDENCY_MODE=strict
# Optional paths to existing private files when deploying from another checkout.
AUTH0_SERVICE_SECRETS_FILE=
BACKUP_ENCRYPTION_KEY_FILE=
# Supply CLOUDFLARE_API_TOKEN through the shell/CI secret store, never VITE_*.
# Requires deployment/R2 access, Zone Read, Regional Services Edit and Logs Read.
