{
  "name": "safeguarding",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/development.ts",
    "build": "npm run typecheck && cf build",
    "deploy": "npm run check && node --experimental-strip-types scripts/deploy.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "security:bucket": "node --experimental-strip-types scripts/check-private-bucket.ts",
    "security:residency": "node --experimental-strip-types scripts/check-residency.ts",
    "backup:restore": "node --experimental-strip-types scripts/restore-backup.ts"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.29.0",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "lucide-react": "^1.62.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.6",
